{
  "name": "vibe-launch-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Unofficial launch analytics + bonding-curve simulator for vibe/vibe on Robinhood Chain Testnet",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "check:model": "node scripts/modelcheck.mjs",
    "check:scan": "tsx scripts/harness.ts",
    "check:render": "tsx scripts/ssr-check.tsx",
    "check:ui": "tsx scripts/ui-check.tsx",
    "verify": "npm run typecheck && npm run check:model && npm run check:scan && npm run check:render",
    "logo": "python tools/make-logo.py && python tools/small-preview.py"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
